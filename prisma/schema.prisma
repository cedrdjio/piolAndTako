// Piol & Tako — data model
// PostgreSQL + Prisma. Images live in Vercel Blob (ListingImage.url).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingCategory {
  PROPERTY
  CAR
  EXPERIENCE
}

enum UserRole {
  GUEST
  HOST
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  image         String?
  role          UserRole   @default(GUEST)
  superhost     Boolean    @default(false)
  responseRate  Int        @default(100)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  listings         Listing[]  @relation("HostListings")
  bookings         Booking[]
  reviews          Review[]
  favorites        Favorite[]
  sentMessages     Message[]  @relation("SentMessages")
  receivedMessages Message[]  @relation("ReceivedMessages")
}

model Listing {
  id           String          @id @default(cuid())
  slug         String          @unique
  category     ListingCategory
  title        String
  summary      String
  description  String
  city         String
  region       String
  country      String          @default("Cameroun")
  latitude     Float
  longitude    Float
  price        Int
  priceUnit    String
  currency     String          @default("XAF")
  rating       Float           @default(0)
  reviewsCount Int             @default(0)
  instantBook  Boolean         @default(true)
  published    Boolean         @default(true)
  badges       String[]
  amenities    String[]
  // Category-specific attributes (guests/bedrooms, seats/transmission, duration…)
  specs        Json
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  hostId    String
  host      User           @relation("HostListings", fields: [hostId], references: [id], onDelete: Cascade)
  images    ListingImage[]
  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]

  @@index([category])
  @@index([city])
  @@index([hostId])
}

model ListingImage {
  id          String  @id @default(cuid())
  url         String
  blurDataUrl String?
  alt         String?
  position    Int     @default(0)
  listingId   String
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Booking {
  id        String        @id @default(cuid())
  listingId String
  guestId   String
  checkIn   DateTime
  checkOut  DateTime
  guests    Int           @default(1)
  total     Int
  currency  String        @default("XAF")
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guest   User    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([guestId])
  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  listingId String
  authorId  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

model Message {
  id         String   @id @default(cuid())
  threadId   String
  senderId   String
  receiverId String
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([receiverId])
}
